# Shared bearer token. Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=changeme

# HTTP/WS port
PORT=3387

# Bind to 127.0.0.1 only (set to 1 for laptop-only; leave blank for LAN)
LOCALHOST_ONLY=

# Recordings storage
RECORDINGS_DIR=./recordings
RECORDINGS_KEEP=20

# Camera snapshots: JPEG bytes on disk, metadata in Mongo. Every snapshot the
# device sends (Sienna's `look` tool + manual Camera-panel captures) is stored
# and shown in the dashboard's Images tab + Activity feed. Keep the newest N.
IMAGES_DIR=./images
SIENNA_IMAGE_KEEP=200

# Verbose device WebSocket logging. Connection/disconnection events always log;
# set to 1 to also log the traffic Sienna sends (mic_rms/ldr/PCM throttled to 1/s).
DEBUG_DEVICE_WS=

# Server→device WebSocket liveness probe (ms). An abrupt device disconnect (power
# loss / Wi-Fi drop) sends no close frame, so without this the dashboard shows the
# device online until the OS TCP keepalive (~2 h). The server pings on this
# interval and drops a device that misses one (→ dashboard flips to offline in
# ~1–2 intervals). 0 disables. Default 10000.
DEVICE_HEARTBEAT_MS=10000

# WAN health probe — disconnect diagnostics for the ISP leg. Every NETPROBE_MS a
# burst of TCP connects to each TARGETS anchor logs WAN RTT + loss; every
# NETPROBE_BANDWIDTH_MS a small download logs achieved Mbps. Correlate the
# [net-probe] lines with the [device-ws] net lines (device RSSI/RTT/throughput):
# WAN bad + device link clean → ISP; reverse → Wi-Fi/LAN. 0 disables either.
SIENNA_NETPROBE_MS=30000
SIENNA_NETPROBE_TARGETS=1.1.1.1:443,8.8.8.8:53
SIENNA_NETPROBE_BANDWIDTH_MS=300000
SIENNA_NETPROBE_BANDWIDTH_URL=https://speed.cloudflare.com/__down?bytes=2000000

# TLS: set both to serve HTTPS/WSS on PORT (required for Web Bluetooth off localhost).
# Generate a self-signed cert with an IP SAN matching the host's LAN address:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout certs/server.key \
#     -out certs/server.crt -days 825 -subj "/CN=sienna-dashboard" \
#     -addext "subjectAltName=IP:192.168.1.111,DNS:localhost,IP:127.0.0.1"
# Leave both blank for plain HTTP.
TLS_CERT=
TLS_KEY=

# "Speak" widget — ElevenLabs text-to-speech. Optional: leave the key blank to
# disable (the Speak button returns 503). The voice + model default to the
# values below; override to use a different voice or model.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=iCrDUkL56s3C8sCRl7wb
ELEVENLABS_MODEL_ID=eleven_v3
# Her GAPLESS streamed reply is sentence-chunked over the HTTP /stream endpoint
# (eleven_v3 too — so it gets inline emotion tags). As the LLM streams, the reply
# is split into sentence-ish chunks synthesized in order: a SMALL first chunk for
# fast first audio, then coalesce toward the target (v3 is shaky on tiny fragments).
# pcm_16000 is the device-native format.
# SIENNA_TTS_CHUNK_FIRST_CHARS=60
# SIENNA_TTS_CHUNK_TARGET_CHARS=200
# ELEVENLABS_STREAM_OUTPUT_FORMAT=pcm_16000

# "Speech" widget — ElevenLabs Scribe realtime speech-to-text. Reuses
# ELEVENLABS_API_KEY above; with that key blank, Push to Talk returns
# "not_configured". Model defaults to scribe_v2_realtime.
ELEVENLABS_STT_MODEL_ID=scribe_v2_realtime
# Optional ISO language code (e.g. en, fr). Leave blank to auto-detect.
ELEVENLABS_STT_LANGUAGE=
# When to finalize (commit) a transcript. "vad" (default) → ElevenLabs' own
# model-based voice-activity detection. Verified against the live API: it
# finalizes ~120-150 ms after you stop and is robust even when the mic noise
# floor is louder than speech (VAD is a model, not an energy gate). "manual" →
# the server endpoints from mic_rms and force-commits (energy-based fallback);
# NOTE manual NEVER auto-commits, so it depends on that endpointer firing. The
# server endpointer (below) runs only in "manual" mode, so the two can't double-
# commit. Tune VAD via the two knobs: SILENCE_SECS lower = faster final.
ELEVENLABS_STT_COMMIT_STRATEGY=vad
# ELEVENLABS_STT_VAD_SILENCE_SECS=0.4
# ELEVENLABS_STT_VAD_THRESHOLD=0.4

# Server-side end-of-speech detection — ONLY used in COMMIT_STRATEGY=manual. An
# EMA noise floor adapts to the room; rms > floor*FACTOR counts as speech;
# SILENCE_MS of quiet after >= MIN_SPEECH_MS of speech finalizes the utterance.
# (This energy detector is what the high-gain mic defeats — hence VAD is the
# default. Kept as a fallback.)
# SIENNA_ENDPOINT_ENABLED=1
# SIENNA_ENDPOINT_SILENCE_MS=400
# SIENNA_ENDPOINT_MIN_SPEECH_MS=150
# SIENNA_ENDPOINT_SPEECH_FACTOR=2.5
# SIENNA_ENDPOINT_ALPHA=0.1

# Commit beep — the "heard you, processing" cue when a finalized transcript routes
# to her, so you know to stop talking. A short rising two-tone chirp: HZ then HZ2,
# each MS long (set HZ2=0 for a single tone). The amplitude is scaled by the master
# volume (SIENNA_VOLUME, below) and clamped, and it's skipped while she's speaking.
# Set ENABLED=0 to silence it.
# SIENNA_COMMIT_BEEP_ENABLED=1
# SIENNA_COMMIT_BEEP_HZ=1540
# SIENNA_COMMIT_BEEP_HZ2=1640
# SIENNA_COMMIT_BEEP_MS=50
# SIENNA_COMMIT_BEEP_AMPLITUDE=0.25

# Push-to-talk (the device's GPIO 46 button). Hold to talk; release finalizes the
# utterance and routes it to her as one turn. MAX_HOLD_MS caps a single hold (a
# stuck button or lost release event must not pin the mic open). RELEASE_GRACE_MS
# waits for the trailing mic frames to reach the transcriber before forcing the
# commit; COMMIT_TIMEOUT_MS bounds the wait for that commit's transcript.
# SIENNA_PTT_MAX_HOLD_MS=60000
# SIENNA_PTT_RELEASE_GRACE_MS=300
# SIENNA_PTT_COMMIT_TIMEOUT_MS=2000

# Listen beep — the "I'm listening" cue the moment a PTT press opens the mic (the
# same rising two-tone chirp the wake word used to play, pitched just below the
# commit beep). HZ2=0 for a single tone; ENABLED=0 to silence it.
# SIENNA_PTT_BEEP_ENABLED=1
# SIENNA_PTT_BEEP_HZ=1440
# SIENNA_PTT_BEEP_HZ2=1540
# SIENNA_PTT_BEEP_MS=50
# SIENNA_PTT_BEEP_AMPLITUDE=0.25

# MongoDB connection string. In Docker this is set automatically by
# docker-compose (pointing at the `mongo` service). For local (non-Docker) dev,
# uncomment and point at your own Mongo to enable the Sienna agent.
# MONGODB_URI=mongodb://localhost:27017/sienna

# ── Sienna agent (the "Sienna" dashboard widget) ─────────────────────────────
# Her server-side agentic loop. Enabled when MONGODB_URI (above) is set AND Gemini
# is configured (below). Otherwise agent_input returns agent_unavailable and the
# rest of the dashboard is unaffected. ElevenLabs (above) powers her `speak` tool +
# gapless streamed reply; without it speech tools just degrade.
#
# Everything LLM runs on Gemini (gemini-2.5-flash, non-thinking, streaming): the
# agent loop, the `look` vision tool, and the Speak-box "Enhance" button. Configure
# via EITHER:
#   (a) a Gemini Developer API key (Google AI Studio) — simplest, no GCP:
# GEMINI_API_KEY=
#   (b) Vertex AI — set BOTH project + location; auth is Application Default
#       Credentials (point GOOGLE_APPLICATION_CREDENTIALS at the service-account JSON):
# GEMINI_VERTEX_PROJECT=my-gcp-project
# GEMINI_VERTEX_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GEMINI_MODEL_ID=gemini-2.5-flash
# Gemini token pricing for the dashboard's Usage view ($ per 1,000,000 tokens).
# Defaults are Gemini 2.5 Flash list prices — VERIFY at ai.google.dev/pricing and
# override to match your plan; they change. Image input is metered as input tokens,
# so IMAGE defaults to the input rate. Each call's cost is locked in at record time.
# GEMINI_PRICE_INPUT_PER_1M=0.30
# GEMINI_PRICE_OUTPUT_PER_1M=2.50
# GEMINI_PRICE_IMAGE_PER_1M=0.30
# Personality record cap (estimated tokens) — it rides in every prompt (cached prefix),
# and grows additively on each reflection tick.
SIENNA_PERSONALITY_TOKEN_CAP=4000
# Output budget for the additive-evolve model call (Pass 1, before the gate).
SIENNA_PERSONALITY_EVOLVE_MAX_TOKENS=5000
# Recent turns + auto-recalled memories included per run.
SIENNA_HISTORY_TURNS=12
SIENNA_RECALL_LIMIT=3
# Per-run wall-clock guard (ms).
SIENNA_RUN_TIMEOUT_MS=60000
# Reflection is event-driven, not timed: each HUMAN interaction (a completed
# push-to-talk / eavesdrop / dashboard turn) cancels any pending reflections and
# schedules a fresh sequence at these offsets from the interaction. Default
# +5 min, +2 h, +24 h — three "quiet moments" tailing off after you talk to her;
# with no further interaction all three run, then she's silent until the next one.
# The list length = reflections per interaction; empty disables reflection.
SIENNA_REFLECTION_DELAYS_MS=300000,7200000,86400000
# Reflection entropy: each tick reflects on a random SAMPLE_SIZE slice shuffled
# out of the newest POOL activity items (messages/memories/personality/tools/
# images), and is shown the last HISTORY reflections so it doesn't repeat them.
SIENNA_REFLECTION_SAMPLE_SIZE=20
SIENNA_REFLECTION_POOL=100
SIENNA_REFLECTION_HISTORY=5
# Ambient autonomy (eavesdrop + camera glance): both run at most once a day, only
# between ACTIVE_HOURS (local Eastern; END is exclusive, so 7–22 = 7am–10pm), gated
# on the Autonomous-speech toggle and skipped mid-conversation. CHECK_MS is how
# often each polls for an opening.
SIENNA_ACTIVE_HOURS_START=7
SIENNA_ACTIVE_HOURS_END=22
SIENNA_AMBIENT_CHECK_MS=1800000
# Eavesdrop: open the mic for SECONDS and route overheard speech as a turn she may
# join; silence is ignored. INTERVAL_MS = minimum gap (default 1 day; 0 disables).
SIENNA_EAVESDROP_INTERVAL_MS=86400000
SIENNA_EAVESDROP_SECONDS=60
# Camera glance: snap one frame, analyze it, and remark ONLY if she sees a person
# (silent otherwise). INTERVAL_MS = minimum gap (default 1 day; 0 disables).
SIENNA_GLANCE_INTERVAL_MS=86400000
# Tool-use loop iteration cap (backstop) + max identical erroring tool calls
# in a row before she's deemed stuck.
SIENNA_MAX_ITERATIONS=12
SIENNA_MAX_TOOL_REPEAT=3
# Media binaries for her play_audio_file / play_youtube / play_music tools (must be
# on PATH or absolute paths). The Docker image installs both.
FFMPEG_PATH=ffmpeg
YT_DLP_PATH=yt-dlp
# yt-dlp youtube:player_client extractor-arg (comma list) applied to every yt-dlp
# call. Lighter clients skip the slow JS signature decryption and shave seconds off
# track extraction (cold AND warm starts). YouTube-version-sensitive — a client can
# break/recover as Google changes things, so this is the knob to tune. Set empty to
# drop the flag and use yt-dlp's own default.
YT_DLP_PLAYER_CLIENTS=default,android
# Loudness cap on music playback (play_audio_file / play_youtube / play_music) — an
# ffmpeg -af chain on the decode; her TTS voice doesn't pass through ffmpeg and is
# untouched. YouTube tracks are mastered at wildly different loudness; the default
# turns hot tracks DOWN to a ceiling and never boosts quiet ones: a slow RMS
# compressor (threshold 0.1 ≈ -20 dBFS, no makeup gain) rides sustained loudness,
# then a lookahead limiter caps peaks at 0.5 (-6 dBFS) — the headroom the default
# SIENNA_VOLUME=200% (+6 dB) consumes, so loud masters stop clipping at the int16
# rails after the master gain. level=false on alimiter matters: its auto-level
# defaults ON and would boost right back up. Set empty to disable.
SIENNA_MUSIC_FILTER=acompressor=threshold=0.1:ratio=12:attack=200:release=1000,alimiter=limit=0.5:level=false
# Music jukebox (play_music): SEARCH_LIMIT is how many YouTube results to pull per
# query — they're shuffled into a never-ending mix (more = more variety, slower first
# search). RESUME_TIMEOUT_MS is how long the mix waits for the speaker to free up
# (after her voice preempts a track) before resuming. Needs yt-dlp + ffmpeg (above).
SIENNA_MUSIC_SEARCH_LIMIT=50
SIENNA_MUSIC_RESUME_TIMEOUT_MS=30000
# No-repeat window: the last N tracks that actually played are remembered (persisted
# in Mongo when available, so it survives restarts) and excluded from every mix — a
# song only comes around again after N others. Asking for a song BY NAME always plays
# it. When a mix runs dry, the search escalates (deeper results, then LLM-suggested
# related queries); if even that finds nothing new, the window is cleared and the
# rotation starts over. 0 disables history tracking.
SIENNA_MUSIC_HISTORY_LIMIT=500
# Restart resume: a live mix is checkpointed to Mongo on every track start, and at
# boot the saved session (current track + remaining queue) resumes once the device
# reconnects — but only if the checkpoint is younger than this (default 1 h, so a
# server that was down overnight doesn't blast music at boot). 0 = always resume.
SIENNA_MUSIC_RESUME_MAX_AGE_MS=3600000
# Buffered playback drain for play_audio_file / play_youtube / play_music. yt-dlp's
# network delivery is jittery, so reading ffmpeg is decoupled from sending to the
# device via an in-memory PCM queue. PREBUFFER_MS builds a lead before the first
# frame so a stall can't underrun the device (the main anti-choppiness knob); if the
# source ends/stalls first, playback starts after PREBUFFER_TIMEOUT_MS anyway.
# MAX_BUFFER_MS bounds memory + applies backpressure to ffmpeg→yt-dlp. Her voice is
# unaffected. Set PREBUFFER_MS=0 for the old start-immediately behavior.
SIENNA_PLAYBACK_PREBUFFER_MS=2000
SIENNA_PLAYBACK_PREBUFFER_TIMEOUT_MS=5000
SIENNA_PLAYBACK_MAX_BUFFER_MS=8000
# Music streaming-health diagnostics. A one-line summary per track (deviceBuf peak,
# backpressure pauses, queue underruns, max inter-frame gap) is ALWAYS logged. Set a
# millisecond interval here to ALSO emit a live "audio-stats" sampler that often while
# a track plays — for watching a stutter happen. Reading it: deviceBuf near its HIGH
# mark with many pauses ⇒ the device Wi-Fi link is saturated; queue hitting 0 with
# underruns while deviceBuf stays low ⇒ upstream yt-dlp/ffmpeg starvation. 0 = summary
# only.
SIENNA_AUDIO_STATS_MS=0
# Per-frame pacing for MUSIC (ms between 2048-sample frames; frame audio = 128 ms, so 128 is
# EXACT realtime). Her VOICE streams ~1.6x realtime to bank short replies on-device, but long
# music tracks must track the DAC rate: over-delivering pins the device's playback ring full
# and overflows it → DROPPED frames (choppy). The device's deep ring (~2.56 s) absorbs Wi-Fi
# jitter both ways, so realtime pacing no longer underruns on a slow burst. Lower toward 120
# only if you still hear gaps (accepting slow overflow on long tracks).
SIENNA_MUSIC_PACING_MS=128
# Per-frame pacing for HER VOICE (ms between 2048-sample frames). DELIVERY rate into the
# device ring, NOT speech speed — the device plays at 16 kHz regardless, so this never
# changes how fast she talks. 80 ≈ 1.6x realtime (banks her short reply on-device so a
# network blip still completes from the buffer); 128 = exact realtime (no bank-ahead).
# Live-tunable via the dashboard TTS-pace slider and persisted across restarts.
SIENNA_TTS_PACING_MS=80
# Lead-in: a "play X" tool speaks a quick heads-up ("getting that…") and the music's
# yt-dlp extraction starts immediately, but the speaker isn't claimed until the
# heads-up finishes — so the announcement is heard AND the slow extraction overlaps
# it. This caps how long the music waits for the heads-up before taking over anyway.
SIENNA_PLAYBACK_LEADIN_TIMEOUT_MS=4000
# Half-duplex echo-tail MARGIN (ms). The server sends audio ~1.6x realtime, so when a clip
# finishes draining the device still has unplayed audio BUFFERED (for a short reply, almost
# the whole thing). The echo gate (mic→Scribe feed + PTT coordinator) AUTOMATICALLY stays
# closed until that buffered audio would finish playing (computed from samples sent vs.
# elapsed time); this knob is the EXTRA cushion on top, for room reverb + Scribe latency.
# Too small ⇒ her last word leaks back as a phantom "user" utterance she replies to. 0 = no
# margin (still waits out the device buffer). Default 500 ≈ reverb decay + first-frame startup
# slop; raise it (600-800) if her last word still leaks, lower it if the mic feels slow to
# re-engage. (Until the firmware half-duplex mic gate is flashed, this server-side hold-off is
# the ONLY thing preventing her own speech from being transcribed back to her.)
SIENNA_ECHO_TAIL_MS=500
# Master speaker volume (percent) — a server-side gain on every PCM frame sent to
# the device (the firmware plays PCM verbatim, so this is the only volume knob).
# 100 = unity; the small amp/speaker run quiet, so the default boosts. Settable
# live by the Voice-panel slider and Sienna's set_volume tool; resets to this on
# restart. SIENNA_VOLUME_MAX caps both the slider and the tool.
SIENNA_VOLUME=200
SIENNA_VOLUME_MAX=400
# Music duck level under her voice: when she talks over playing music, the music
# keeps going at this percent of its level (a quiet bed mixed under her), then
# returns to full volume when she finishes. 0 disables ducking (music goes
# silent under her voice instead).
SIENNA_DUCK_PERCENT=20
# Music level while the PTT button is held. 0 (default) = full mute: pressing
# the button silences music instantly (the firmware also hard-gates the speaker
# on the raw button level, so the cut is within one ~64 ms audio frame) and the
# music rejoins live when your speech is committed. >0 streams a quiet ducked
# bed instead — but the firmware discards all speaker frames while the button is
# physically down, so the bed is only audible between release and finalize, and
# >0 requires the firmware that lifts the half-duplex mic gate while held.
SIENNA_PTT_DUCK_PERCENT=0
# Weather (Open-Meteo — free, no API key required). The agent gets ambient current
# conditions refreshed every WEATHER_REFRESH_MS into her "Right now" context, plus a
# check_weather forecast tool (8am conditions + the day's high/low for a given date)
# that reaches ~16 days out. Only active when the agent is enabled (above). Location
# defaults to Kanata, Ontario.
WEATHER_LAT=45.3333
WEATHER_LON=-75.9000
WEATHER_REFRESH_MS=1800000

# ── Docker (docker compose up) ───────────────────────────────────────────────
# These are consumed by docker-compose.yml. In the container the server serves
# HTTPS/WSS on 3387 and binds 0.0.0.0: compose overrides LOCALHOST_ONLY (so the
# published port works) and points TLS_CERT/TLS_KEY at ./certs bind-mounted
# read-only, so you reach it at https://<host>:${SERVER_PORT}/. Generate the
# certs first (see the TLS section above).

# Host port to publish the dashboard on (container always listens on 3387).
SERVER_PORT=3387

# MongoDB service credentials + database. The server receives these wired into
# MONGODB_URI as mongodb://<user>:<pass>@mongo:27017/<db>?authSource=admin.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_DB=sienna
# Host port to publish MongoDB on (handy for GUI tools; remove the mapping in
# docker-compose.yml if you don't want it exposed).
MONGO_PORT=27017
